+// The merged tree 4-wide (StaticTraceTree.Wide, README part 53): a node is three entries, the four children's x, y and z bounds
+// (min, max as float4s) and in the entries' links the children's links and kinds (0 a node, TriangleLeaf | count a leaf of stored
+// triangles, 0xffffffff none). The four boxes are tested together against the ray in world space, padded as LocalBox pads them
+// (beyond the rounding of the triangles' world coordinates, so no box is missed that a triangle test would hit), leaves are
+// tested at once and nodes pushed farthest first, each culled when popped if a closer hit has been found since. The leaves and the
+// triangle tests are the binary tree's and ties go to the lower primitive, so the hits do not depend on the tree.
+#ifdef USE_BVH
+bool TraceWide(uint root, float3 boundsLow, float3 boundsHigh, float3 origin, float3 direction, float minimum, bool anyHit,
+               inout uint hit, inout float distance, inout float3 normal)
+{
+    float3 inv = float3(SafeInverse(direction.x), SafeInverse(direction.y), SafeInverse(direction.z));
+    float3 m = max(abs(boundsLow), abs(boundsHigh)), q = abs(origin);
+    float pad = 16 * 1.1920929e-7 * (1 + 4 * max(m.x, max(m.y, m.z)) + max(q.x, max(q.y, q.z)));
+    uint stack[48]; float near[48];
+    uint depth = 0, node = root;
+    while (true)
+    {
+        BvhNode ex = BvhNodes[node], ey = BvhNodes[node + 1], ez = BvhNodes[node + 2];
+        PROFILE_NODE();
+        float4 ax = (ex.boundsMin - pad - origin.x) * inv.x, bx = (ex.boundsMax + pad - origin.x) * inv.x;
+        float4 ay = (ey.boundsMin - pad - origin.y) * inv.y, by = (ey.boundsMax + pad - origin.y) * inv.y;
+        float4 az = (ez.boundsMin - pad - origin.z) * inv.z, bz = (ez.boundsMax + pad - origin.z) * inv.z;
+        float4 enter = max(max(min(ax, bx), min(ay, by)), max(min(az, bz), 0));
+        float4 leave = min(min(max(ax, bx), max(ay, by)), min(max(az, bz), distance));
+        // Children to descend, nearest last on the stack (an insertion into the up to four found).
+        uint found = 0, order[4]; float at[4];
