+            if (kind == 0xffffffff || !(enter[c] <= leave[c])) continue;
+            if ((kind & TriangleLeaf) != 0)
+            {
+                for (uint stored = 0; stored < (kind & 0xffffu); stored++)
+                    if (ConsiderTriangle(BvhNodes[ex.links[c] + stored], origin, direction, minimum, hit, distance, normal) && anyHit) return true;
+                continue;
+            }
+            order[found] = ex.links[c]; at[found] = enter[c]; found++;
+        }
+        // Push farthest first (selection over the up to four found).
+        for (uint i = 0; i < found; i++)
+        {
+            uint farthest = i;
+            for (uint j = i + 1; j < found; j++) if (at[j] > at[farthest]) farthest = j;
