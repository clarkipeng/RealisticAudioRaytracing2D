+// Path guiding (settings.pathGuiding, README part 50): at a scattering point the next direction is drawn by one-sample MIS
+// between Lambert's law and a directional distribution learned, per primitive, from the rays' own contributions at the
+// listener, and weighted by 1 / (the mixture's density), so every estimate stays unbiased.
+//  * Learning. A ray remembers its latest scattering point's primitive, the direction bin it left in and 1 / (W p), W its
+//    band-summed flux on leaving and p the density it was drawn with. Every contribution it makes afterwards (beams, next-event
+//    and edge connections at its later vertices, its transmitted branch's) adds E / (W p) to that primitive's bin, E the
+//    contribution's band-summed energy: the bins then estimate the integral over each bin of the importance (energy at the
+//    listener per unit flux sent in that direction), a sample's 1 / p making it an estimate of the importance rather than of
+//    the importance times the density it was drawn with (Vorba et al. 2014; Mueller et al. 2017 splat the same quantity).
+//  * Forgetting. Each update multiplies the statistics by exp(-|dL| / R), dL the listener's move since the last update and R
+//    its clearance: the image lattice the beams score at changes when the listener moves by about R (part 8); a listener at
+//    rest keeps them all. A flush resets them.
+//  * Sampling. With probability 1/2, if the primitive has statistics, the direction is drawn from its bins (bin by its share,
+//    uniformly within it), otherwise by Lambert's law; the density is 1/2 p_guide + 1/2 cos / pi. The defensive half (Hesterberg
+//    1995) bounds the weight cos / (pi p) by 2, and keeps every direction Lambert's law reaches possible.
+// Bins: 4 equal-area bands of the vertical axis times 8 sectors of azimuth, so every bin spans 4 pi / 32 sr. The statistics
+// (unsigned 32.32 fixed point) and each primitive's cumulative shares (its last word: the total) follow the cohort counts in
+// PathCohortCount (no buffer is added to the walk, which binds close to the limits, part 31).
+uint PathGuiding, PathGuideBase, PathGuideCdfBase, PathGuideListenerBase, PathGuideParity, PathGuideFresh;
+static const uint PathGuideBins = 32;
+uint PathGuideBin(float3 w)
+{
+    uint band = min(3u, (uint)max(0, floor((w.y + 1) * 2)));
+    float phi = atan2(w.z, w.x);
+    return band * 8 + min(7u, (uint)max(0, floor((phi + RayPi) * (4 / RayPi))));
+}
+float3 PathGuideDirection(uint bin, inout uint rng)
+{
+    float y = -1 + ((bin >> 3) + RandomRay(rng)) * .5, phi = ((bin & 7) + RandomRay(rng)) * (RayPi / 4) - RayPi, r = sqrt(max(0, 1 - y * y));
+    return float3(r * cos(phi), y, r * sin(phi));
+}
+float PathGuideShare(uint cdf, uint bin) // the bin's share of the primitive's statistics
+{
+    float upper = bin + 1 < PathGuideBins ? asfloat(PathCohortCount[cdf + bin]) : 1;
+    return upper - (bin > 0 ? asfloat(PathCohortCount[cdf + bin - 1]) : 0);
