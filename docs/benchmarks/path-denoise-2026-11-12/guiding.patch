+    if (part >= 4294967296.0) { whole += 1; part -= 4294967296.0; }
+    uint low = (uint)part, high = (uint)min(whole, 4294967295.0), old;
+    InterlockedAdd(PathCohortCount[at], low, old);
+    if (old + low < old) high++;
+    if (high != 0) InterlockedAdd(PathCohortCount[at + 1], high);
+}
