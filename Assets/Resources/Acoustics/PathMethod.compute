// The Path method (one energy path tracer, docs/benchmarks/path-tracer-2026-11-12) in its own
// compute shader: it compiles only when that method is used. One solve: PathEdgeWeights and
// PathEdgeScan (the source's edge-ray distribution), PathClearance (the listener's clearance for the
// beam kernel), then per chunk of rays TracePath (the loop), and for audio PathExpand (the exact
// direct arrival as delayed paths). Persistent rays: PathPersistentBeginKernel, then TracePath over the
// rays kept from the previous update and the new ones, population control (PathSortCount, PathSortScan and
// PathSortScatter: the kept rays resampled and written in coherent order), then PathRingKernel (the update's histogram).
#pragma kernel TracePath3D
#pragma kernel TracePath3DBvh USE_BVH
// With the delay rates (MethodPath.hlsl "Delay rates"), dispatched while anything moves (MethodTransport.Doppler).
#pragma kernel TracePath3DDoppler PATH_DOPPLER
#pragma kernel TracePath3DBvhDoppler USE_BVH PATH_DOPPLER
// Diffraction as an event of the walk (settings.pathWalkDiffraction, MethodPath.hlsl "Walk diffraction"); static scenes only.
#pragma kernel TracePath3DWalk PATH_WALK_EDGE
#pragma kernel TracePath3DBvhWalk USE_BVH PATH_WALK_EDGE
// The work profile (MethodTransport.WorkProfile, README part 46): the Doppler walk counting its scene traversals per kind of query.
#pragma kernel TracePath3DBvhProfile USE_BVH PATH_DOPPLER PATH_PROFILE
#pragma kernel PathTraceBenchKernel USE_BVH
#pragma kernel PathEdgeWeights3D
#pragma kernel PathEdgeWeights3DBvh USE_BVH
#pragma kernel PathEdgeScan
#pragma kernel PathExpandDirect
#pragma kernel PathClear
#pragma kernel PathClearance3D
#pragma kernel PathClearance3DBvh USE_BVH
#pragma kernel PathEndsMedia3D
#pragma kernel PathEndsMedia3DBvh USE_BVH
#pragma kernel PathPersistentBeginKernel
#pragma kernel PathRingKernel
#pragma kernel PathEdgeCopyKernel
#pragma kernel PathSortCountKernel
#pragma kernel PathSortScanKernel
#pragma kernel PathSortScatterKernel

// The Doppler walks read the edge distribution and the listener's clearance through read-only views of them
// (MethodCommon.hlsl, MethodPath.hlsl): as UAVs they made 10, over the 8 Unity supports (README part 44). Only there:
// the static walks compile as before, so their outputs stay bit-identical.
#if defined(PATH_DOPPLER)
StructuredBuffer<float> MethodEdgeCdfRead;
#define METHOD_EDGE_CDF_READ MethodEdgeCdfRead
#endif
// Every walk reads the listener's clearance and medium through a read-only view (README part 47).
StructuredBuffer<uint> PathClearanceRead;
#define PATH_CLEARANCE_READ PathClearanceRead
#include "../../Shaders/Geometry.hlsl"
#include "../../Shaders/Transport.hlsl"
#include "../../Shaders/MethodCommon.hlsl"
#include "../../Shaders/MethodPath.hlsl"
// A walk's thread row is its pair (the merged walk, MethodCommon.hlsl; one row when the pairs are walked one by one).

[numthreads(64,1,1)] void TracePath3D(uint3 id:SV_DispatchThreadID) { PathPairIndex = id.y; TracePath(id.x); }
[numthreads(64,1,1)] void TracePath3DBvh(uint3 id:SV_DispatchThreadID) { PathPairIndex = id.y; TracePath(id.x); }
[numthreads(64,1,1)] void TracePath3DDoppler(uint3 id:SV_DispatchThreadID) { PathPairIndex = id.y; TracePath(id.x); }
[numthreads(64,1,1)] void TracePath3DBvhDoppler(uint3 id:SV_DispatchThreadID) { PathPairIndex = id.y; TracePath(id.x); }
[numthreads(64,1,1)] void TracePath3DWalk(uint3 id:SV_DispatchThreadID) { PathPairIndex = id.y; TracePath(id.x); }
[numthreads(64,1,1)] void TracePath3DBvhWalk(uint3 id:SV_DispatchThreadID) { PathPairIndex = id.y; TracePath(id.x); }
[numthreads(64,1,1)] void TracePath3DBvhProfile(uint3 id:SV_DispatchThreadID) { PathPairIndex = id.y; TracePath(id.x); }
[numthreads(64,1,1)] void PathTraceBenchKernel(uint3 id:SV_DispatchThreadID) { PathTraceBench(id.x + MethodRayOffset); }
[numthreads(64,1,1)] void PathEdgeWeights3D(uint3 id:SV_DispatchThreadID) { PathEdgeWeights(id.x); }
[numthreads(64,1,1)] void PathEdgeWeights3DBvh(uint3 id:SV_DispatchThreadID) { PathEdgeWeights(id.x); }
[numthreads(256,1,1)] void PathEdgeScan(uint3 t:SV_GroupThreadID) { EnergyEdgeScan(t.x); }
[numthreads(256,1,1)] void PathClearance3D(uint3 t:SV_GroupThreadID) { PathClearance(t.x); }
[numthreads(256,1,1)] void PathClearance3DBvh(uint3 t:SV_GroupThreadID) { PathClearance(t.x); }
[numthreads(2,1,1)] void PathEndsMedia3D(uint3 t:SV_GroupThreadID) { PathEndsMedia(t.x); }
[numthreads(2,1,1)] void PathEndsMedia3DBvh(uint3 t:SV_GroupThreadID) { PathEndsMedia(t.x); }
[numthreads(1,1,1)] void PathPersistentBeginKernel(uint3 id:SV_DispatchThreadID) { PathPersistentBegin(); }
[numthreads(64,1,1)] void PathSortCountKernel(uint3 id:SV_DispatchThreadID) { PathSortCount(id.x + MethodRayOffset); }
[numthreads(1024,1,1)] void PathSortScanKernel(uint3 t:SV_GroupThreadID) { PathSortScan(t.x); }
[numthreads(64,1,1)] void PathSortScatterKernel(uint3 id:SV_DispatchThreadID) { PathSortScatter(id.x + MethodRayOffset); }
[numthreads(64,1,1)] void PathEdgeCopyKernel(uint3 id:SV_DispatchThreadID) { PathEdgeCopy(id.x); }
[numthreads(64,1,1)] void PathRingKernel(uint3 id:SV_DispatchThreadID) { PathRing(id.x); }
[numthreads(64,1,1)] void PathExpandDirect(uint3 id:SV_DispatchThreadID) { PathExpand(id.x); }
[numthreads(64,1,1)] void PathClear(uint3 id:SV_DispatchThreadID)
{
    ClearMethodBuffers(id.x);
    uint i = id.x + MethodClearOffset;
    if (i < MethodCountCells) MethodArrivalCounts[i] = 0;
    if (i < PathCountCells) PathCounts[i] = 0;
    if (i < PathRateClearCount) MethodOutput[PathRateClearBase + i] = 0;
}
