// The Path method (one energy path tracer, docs/benchmarks/path-tracer-2026-11-12) in its own
// compute shader: it compiles only when that method is used. One solve: PathEdgeWeights and
// PathEdgeScan (the source's edge-ray distribution), TracePath (the loop), and for audio
// PathExpand (the exact direct arrival as delayed paths).
#pragma kernel TracePath3D
#pragma kernel TracePath3DBvh USE_BVH
#pragma kernel PathEdgeWeights3D
#pragma kernel PathEdgeWeights3DBvh USE_BVH
#pragma kernel PathEdgeScan
#pragma kernel PathExpandDirect
#pragma kernel PathClear

#include "../../Shaders/Geometry.hlsl"
#include "../../Shaders/Transport.hlsl"
#include "../../Shaders/MethodCommon.hlsl"
#include "../../Shaders/MethodEnergy.hlsl"
#include "../../Shaders/MethodPath.hlsl"

[numthreads(64,1,1)] void TracePath3D(uint3 id:SV_DispatchThreadID) { TracePath(id.x); }
[numthreads(64,1,1)] void TracePath3DBvh(uint3 id:SV_DispatchThreadID) { TracePath(id.x); }
[numthreads(64,1,1)] void PathEdgeWeights3D(uint3 id:SV_DispatchThreadID) { EnergyEdgeWeights(id.x); }
[numthreads(64,1,1)] void PathEdgeWeights3DBvh(uint3 id:SV_DispatchThreadID) { EnergyEdgeWeights(id.x); }
[numthreads(256,1,1)] void PathEdgeScan(uint3 t:SV_GroupThreadID) { EnergyEdgeScan(t.x); }
[numthreads(64,1,1)] void PathExpandDirect(uint3 id:SV_DispatchThreadID) { PathExpand(id.x); }
[numthreads(64,1,1)] void PathClear(uint3 id:SV_DispatchThreadID)
{
    ClearMethodBuffers(id.x);
    uint i = id.x + MethodClearOffset;
    if (i < MethodCountCells) MethodArrivalCounts[i] = 0;
    if (i < PathCountCells) PathCounts[i] = 0;
}
