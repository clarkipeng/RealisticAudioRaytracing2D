// Doppler on reflections (PathReverb.cs, README part 40): the early part's slots slide at their bins' delay rates.
// PathSlideSelect (one thread per pair, before PathGroups) picks the echoes from the raw histogram, its counts, its
// direction channels and its rate channel, and gives each its mean delay, slide rate and per-ear band amplitudes;
// PathGroups leaves the echoes out of the kernel; PathBandInput keeps the band-filtered input of each block in a ring;
// PathSlide adds each bank's echoes to its output block.
RWStructuredBuffer<uint> PathSlideEchoes;       // [bank][pair][bin]: 1 for an echo
StructuredBuffer<uint> PathSlideEchoesRead;     // (the same buffer, read only: PathGroups and PathSlide)
RWStructuredBuffer<float> PathSlideRates;       // [bank][pair][bin]: the echoes' slide rates
RWStructuredBuffer<float> PathSlideDelays;      // [bank][pair][bin][channel]: their mean delays per ear (with the ITD), in samples
RWStructuredBuffer<float> PathSlideAmplitudes;  // [bank][pair][bin][channel][band]
RWStructuredBuffer<uint> PathSlideEnd;          // [bank][pair]: one past the last slid bin
RWStructuredBuffer<float> PathBandHistory;      // [source][band][PathHistoryLength]
StructuredBuffer<uint> PathBinCounts;           // the tracer's contributions per [frame][pair][bin] (PathCountOffset: the frame's)
StructuredBuffer<float> PathBinStarts;          // [bin + 1]: its start in samples (the last: the horizon's end)
// PathDoppler: settings.pathReflectionDoppler (0: the rates are ignored); PathDelayMoments: the walk computed the rate
// channel (MethodTransport.Doppler), so its delay moment gives each echo's mean delay.
uint PathRateOffset,PathCountOffset,PathHistoryLength,PathSincRadius,PathSincFilter,PathDoppler,PathDelayMoments;
// Interaural delay of the echoes (PathReverb.EchoDirection, Hrtf.InterauralDelay; README part 42): the HRTF set's ITD in
// seconds over head-frame directions, [elevation 91][azimuth 181] every 2 degrees, read bilinearly.
StructuredBuffer<float> PathItd;
