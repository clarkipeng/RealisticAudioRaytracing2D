[numthreads(64,1,1)]
void LateWrite(uint3 id:SV_DispatchThreadID)
{
    uint i=id.x,channels=AudioListeners*AudioChannels;if(i>=AudioWriteCount*channels)return;
    uint n=i/channels,c=i%channels;
    int time=AudioDifference(AudioBlockSample,LateSwap)+(int)AudioWriteAt+(int)n;
    uint at=(uint)(((int)AudioBlockSample.x+(int)AudioWriteAt+(int)n)&(int)(LatePartition-1));
    float weight=LateBlend!=0?saturate(time/(float)LateStep):1;
