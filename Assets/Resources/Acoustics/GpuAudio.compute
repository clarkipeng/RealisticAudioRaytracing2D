[numthreads(256,1,1)]
void AudioButterfly(uint3 group:SV_GroupID,uint3 tid:SV_GroupThreadID)
{
    uint g=AudioTransformBase+group.x,n=AudioTransformSize,step=AudioStage;if(AudioSkipTransform(AudioTransformPathBase+group.x))return;
