[numthreads(64,1,1)]
void LateSum(uint3 id:SV_DispatchThreadID)
{
    uint bin=id.x,tile=id.y,channel=id.z;if(bin>=LateBins)return;
    uint listener=channel/AudioChannels,c=channel%AudioChannels,bank=LateBank^LateWhich,count=AudioPairs*AudioChannels*LateCount*LateBins;
    float2 value=0;
    for(uint pair=listener;pair<AudioPairs;pair+=AudioListeners)
    {
