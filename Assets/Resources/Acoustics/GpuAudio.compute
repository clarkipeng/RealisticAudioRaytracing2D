// No transform-size cap: global FFT stages are the fallback above shared memory.
[numthreads(256,1,1)]
void AudioMaterialGlobal(uint3 group:SV_GroupID,uint3 tid:SV_GroupThreadID)
{
    if(AudioPairState[AudioPair].z==0)return;uint g=AudioRanges[AudioPair].x+group.x;
    for(uint k=tid.x;k<AudioSize;k+=256){uint bin=min(k,AudioSize-k);float2 gain=0;int i=AudioHeads[g];for(uint visit=0;visit<AudioRanges[AudioPair].y && i>=0;visit++){AudioPath p=AudioArrivals[AudioOffset+i];if(p.frequencyBin==bin)gain+=float2(p.pressureGain,p.pressureImag);i=AudioNext[i];}if(i>=0)AudioError(4);if(k==0 || k==AudioSize/2)gain.y=0;else if(k>AudioSize/2)gain.y=-gain.y;AudioTransform[group.x*AudioFft+k]=gain;}
}
[numthreads(256,1,1)]
void AudioPadGlobal(uint3 group:SV_GroupID,uint3 tid:SV_GroupThreadID)
{
    if(AudioPairState[AudioPair].z==0)return;uint g=AudioRanges[AudioPair].x+group.x;
    for(uint n=tid.x;n<AudioFft;n+=256)AudioWork[AudioWorkAt(g)+n]=n<AudioSize?float2(AudioTransform[group.x*AudioFft+(n+AudioSize/2)%AudioSize].x,0):0;
}
[numthreads(256,1,1)]
void AudioFilterGlobal(uint3 group:SV_GroupID,uint3 tid:SV_GroupThreadID)
{
    if(AudioPairState[AudioPair].z==0)return;uint g=AudioRanges[AudioPair].x+group.x;
    for(uint k=tid.x;k<AudioBins;k+=256)AudioFilters[AudioFilterAt(AudioPairState[AudioPair].x,g)+k]=AudioWork[AudioWorkAt(g)+k];
