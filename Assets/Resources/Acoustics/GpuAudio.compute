float PathEarEnergy(uint pair,uint c,uint b,uint k)
{
    float energy=0;
    for(uint d=0;d<LATE_DIRECTIONS;d++)
    {
        uint cell=((pair*LATE_DIRECTIONS+d)*LATE_BANDS+b)*PathBinsCount+k;
        float e=PathFloat!=0?PathHistogram[cell]:(LateHistogram[2*(PathFixedOffset+cell)+1]+LateHistogram[2*(PathFixedOffset+cell)]/4294967296.0)/LateRays;
        if(e>0)energy+=PathEarWeights[(d*2+c)*LATE_BANDS+b]*e;
    }
