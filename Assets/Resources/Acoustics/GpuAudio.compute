    }
}
// Twiddles exp(-2 pi i j / 2048), j < 1024, computed in double precision once (GpuAudio); the table replaces a
// sine and a cosine per butterfly.
StructuredBuffer<float2> AudioTwiddles;
// Radix 2, decimation in time, in place. The stages are done two at a time (spans h and 2h on four elements held in
// registers, README part 37): the same butterflies in the same order, so the result is bit for bit the radix-2 one, with
// half the barriers and half the shared-memory passes. An odd number of stages starts with one stage alone.
// AudioFftSingle (profiling only) runs one stage per pass, as before.
uint AudioFftSingle;
void AudioFftShared(uint n,bool inverse,uint thread)
{
    uint bits=(uint)firstbithigh(n);
    for(uint i=thread;i<n;i+=256){uint j=reversebits(i)>>(32-bits);if(j>i){float2 v=AudioShared[i];AudioShared[i]=AudioShared[j];AudioShared[j]=v;}}
    GroupMemoryBarrierWithGroupSync();
    uint step=2;
    if((bits&1)!=0 || AudioFftSingle!=0)
    {
        for(;step<=n;step*=2)
        {
            for(uint i=thread;i<n/2;i+=256)
            {
                uint k=i%(step/2),at=(i/(step/2))*step+k;float2 w=AudioTwiddles[k*(AUDIO_SHARED/step)];if(inverse)w.y=-w.y;
                float2 a=AudioShared[at],b=AudioMultiply(AudioShared[at+step/2],w);
                AudioShared[at]=a+b;AudioShared[at+step/2]=a-b;
            }
            GroupMemoryBarrierWithGroupSync();
            if(AudioFftSingle==0){step*=2;break;}
        }
    }
    for(;2*step<=n;step*=4)
    {
        uint h=step/2;
        for(uint j=thread;j<n/4;j+=256)
        {
            uint k=j%h,at=(j/h)*4*h+k;
            float2 w1=AudioTwiddles[k*(AUDIO_SHARED/step)],w2=AudioTwiddles[k*(AUDIO_SHARED/(2*step))],w3=AudioTwiddles[(k+h)*(AUDIO_SHARED/(2*step))];
            if(inverse){w1.y=-w1.y;w2.y=-w2.y;w3.y=-w3.y;}
            float2 x0=AudioShared[at],x1=AudioShared[at+h],x2=AudioShared[at+2*h],x3=AudioShared[at+3*h];
            float2 b=AudioMultiply(x1,w1),y0=x0+b,y1=x0-b;
            b=AudioMultiply(x3,w1);float2 y2=x2+b,y3=x2-b;
            b=AudioMultiply(y2,w2);AudioShared[at]=y0+b;AudioShared[at+2*h]=y0-b;
            b=AudioMultiply(y3,w3);AudioShared[at+h]=y1+b;AudioShared[at+3*h]=y1-b;
        }
        GroupMemoryBarrierWithGroupSync();
    }
    if(inverse){for(uint i=thread;i<n;i+=256)AudioShared[i]/=n;GroupMemoryBarrierWithGroupSync();}
}
[numthreads(256,1,1)]
void AudioFilter(uint3 group:SV_GroupID,uint3 tid:SV_GroupThreadID)
{
    if(tid.x==0)AudioSkip=AudioPairState[AudioPair].z==0?1:0;GroupMemoryBarrierWithGroupSync();
    if(AudioSkip!=0)return;uint g=AudioRanges[AudioPair].x+group.x,t=tid.x;
    for(uint n=t;n<AudioSize;n+=256)AudioShared[n]=0;GroupMemoryBarrierWithGroupSync();
    if(t==0)
    {
        int i=AudioHeads[g];
        for(uint visit=0;visit<AudioRanges[AudioPair].y && i>=0;visit++){AudioPath p=AudioArrivals[AudioOffset+i];AudioShared[p.frequencyBin]+=float2(p.pressureGain,p.pressureImag);i=AudioNext[i];}
        if(i>=0)AudioError(4);
        AudioShared[0].y=AudioShared[AudioSize/2].y=0;
    }
    GroupMemoryBarrierWithGroupSync();
    for(uint mirror=t+1;mirror<AudioSize/2;mirror+=256)AudioShared[AudioSize-mirror]=AudioShared[mirror]*float2(1,-1);GroupMemoryBarrierWithGroupSync();
    AudioFftShared(AudioSize,true,t);
