[numthreads(256,1,1)]
void LateInput(uint3 group:SV_GroupID,uint3 tid:SV_GroupThreadID)
{
    uint source=group.x,t=tid.x,ring=LateBlock%LateCount,size=2*LatePartition;
    if(t==0)
    {
        uint used=0;
        for(uint l=0;l<AudioListeners;l++)used|=LateActive[LateBank*AudioPairs+source*AudioListeners+l]|LateActive[(LateBank^1)*AudioPairs+source*AudioListeners+l];
        AudioSkip=used!=0?0:1;
    }
    GroupMemoryBarrierWithGroupSync();
    // An unheard source contributes silence to every later block that reads this slot.
    if(AudioSkip!=0){for(uint k=t;k<LateBins;k+=256)LateInputs[(source*LateCount+ring)*LateBins+k]=0;return;}
    // Declared DSP latency = AudioLatency + AudioSize/2 (the centred path filter).
    for(uint n=t;n<size;n+=256)AudioShared[n]=float2(LateDry(source,(int)n-(int)LatePartition-AudioLatency-(int)AudioSize/2),0);
    GroupMemoryBarrierWithGroupSync();
