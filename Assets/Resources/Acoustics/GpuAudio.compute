// Error-free product splitting keeps fractional delays accurate without GPU
// float64. Only bounded offsets use floats; integer sample/ring clocks never do.
float2 AudioProduct(float a,float b)
{
    precise float p=a*b,ca=4097*a,cb=4097*b;
    precise float ah=ca-(ca-a),al=a-ah,bh=cb-(cb-b),bl=b-bh;
    precise float error=((ah*bh-p)+ah*bl+al*bh)+al*bl;return float2(p,error);
}
void AudioSplit(float2 v,out int whole,out float fraction)
{
    float f=floor(v.x);fraction=(v.x-f)+v.y;float adjust=floor(fraction);whole=(int)f+(int)adjust;fraction-=adjust;
}
float AudioRead(uint source,int at,AudioPath path)
{
    // Samples before initialization are measured zero, not missing history.
    if(AudioBlockNegative!=0 && at<-(int)AudioBlockSample.x)return 0;
    if(at<AudioAvailableStart || at>=AudioAvailableEnd){AudioError(2);return 0;}
    int ring=(AudioRingAt+at)%(int)AudioHistory;if(ring<0)ring+=AudioHistory;
    uint4 clip=AudioClipInfo[source];
    if(clip.w!=0)
    {
        uint4 clock=AudioSourceClocks[clip.z*AudioHistory+ring];
        uint phase=path.emissionPhase;
        if((phase&0x80000000u)!=0)
        {
            // The full epoch comparison rejects an old burst after a restart.
            if(clock.w>path.birthHigh || (clock.w==path.birthHigh && clock.z>path.birthLow))return 0;
            int age=AudioDifference(AudioBlockSample,uint2(path.birthLow,path.birthHigh))+at;
            if((clip.w&0x80000000u)!=0)
            {
                if(age<0 || age>=(int)clip.y)return 0;
                return AudioClips[clip.x+(uint)age]*asfloat(clock.y);
            }
            if(age<=0 || age>=(int)clip.w-2)return 0;
            float window=.5-.5*cos(2*AUDIO_PI*age/(clip.w-2));
            uint index=((clock.x%clip.y)+(phase&0x7fffffffu))%clip.y;
            index=(index+(uint)age%clip.y)%clip.y;
