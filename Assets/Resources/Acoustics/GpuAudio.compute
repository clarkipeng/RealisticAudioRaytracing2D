// Late field (LateReverb.cs is the CPU reference). Kernels of the current bank are
// LateBasis noise shaped by the histogram envelope; each source's emitted signal,
// delayed by the DSP latency, is convolved by uniform partitioned overlap-save in
// blocks of LatePartition samples, and the previous bank fades out over one step.
StructuredBuffer<uint> LateHistogram;
StructuredBuffer<uint4> LateEmissionRanges,LateEmissionClocks;
StructuredBuffer<float4> LateEmissionPoints;
StructuredBuffer<float2> LateBasisSpectra;
StructuredBuffer<float> LateEarWeights;
StructuredBuffer<uint> LateOffsets;
RWStructuredBuffer<float> LateGains,LateBlocks;
RWStructuredBuffer<float2> LateKernels,LateInputs,LateSums;
RWStructuredBuffer<uint> LateActive;
uint LatePartition,LateCount,LateBasisCount,LateBins,LateBank,LateHistogramOffset,LateRays,LateEmissionRow,LateValid,LateTiles,LateWhich,LateBlend,LateStep,LateBlock;
uint2 LateSwap;
static const uint LATE_BANDS=8,LATE_DIRECTIONS=6;
[numthreads(64,1,1)]
void LateEnvelope(uint3 id:SV_DispatchThreadID)
{
    uint count=AudioPairs*AudioChannels*LATE_BANDS*LateCount;if(id.x>=count)return;
    uint k=id.x%LateCount,b=(id.x/LateCount)%LATE_BANDS,c=(id.x/(LateCount*LATE_BANDS))%AudioChannels,pair=id.x/(LateCount*LATE_BANDS*AudioChannels);
    bool active=LateValid!=0 && AudioFilterPairs[pair]>=0 && AudioHeadsPose[AudioPoseOffset+AudioListeners+pair%AudioListeners].x!=0;
    if(id.x%(LateCount*LATE_BANDS*AudioChannels)==0)LateActive[LateBank*AudioPairs+pair]=active?1:0;
    float energy=0;
    if(active)for(uint d=0;d<LATE_DIRECTIONS;d++)
    {
        uint cell=LateHistogramOffset/2+((pair*LATE_DIRECTIONS+d)*LATE_BANDS+b)*LateCount+k;
        energy+=LateEarWeights[(d*2+c)*LATE_BANDS+b]*((LateHistogram[2*cell+1]+LateHistogram[2*cell]/4294967296.0)/LateRays);
    }
    LateGains[id.x]=sqrt(max(0,energy)/LatePartition);
}
[numthreads(64,1,1)]
void LateBuild(uint3 id:SV_DispatchThreadID)
{
    uint count=AudioPairs*AudioChannels*LateCount*LateBins;if(id.x>=count)return;
    uint bin=id.x%LateBins,k=(id.x/LateBins)%LateCount,c=(id.x/(LateBins*LateCount))%AudioChannels,pair=id.x/(LateBins*LateCount*AudioChannels);
    uint noise=(LateOffsets[pair]+k)%LateBasisCount;float2 value=0;
    for(uint b=0;b<LATE_BANDS;b++)
    {
        float gain=LateGains[((pair*AudioChannels+c)*LATE_BANDS+b)*LateCount+k];
        if(gain!=0)value+=LateBasisSpectra[((c*LATE_BANDS+b)*LateBasisCount+noise)*LateBins+bin]*gain;
    }
    LateKernels[LateBank*count+id.x]=value;
}
float LateDry(uint source,int at)
{
    uint4 row=LateEmissionRanges[LateEmissionRow+source];
    AudioPath path=(AudioPath)0;
    if(row.w==0)return AudioRead(source,at,path);
    float value=0;
    for(uint n=0;n<row.y;n++)
    {
        float amplitude=LateEmissionPoints[row.x+n].w;if(amplitude==0)continue;
        if(row.w==2){uint4 clock=LateEmissionClocks[row.x+n];path.emissionPhase=clock.x;path.birthLow=clock.y;path.birthHigh=clock.z;}
        else path.emissionPhase=AudioHash(row.z^(n*0x85ebca6bu+0x9e3779b9u))>>16;
        value+=amplitude*AudioRead(source,at,path);
    }
    return value;
