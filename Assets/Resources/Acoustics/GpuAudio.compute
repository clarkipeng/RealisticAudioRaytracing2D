float PathInterauralDelay(float3 direction)
{
    if(!(dot(direction,direction)>0))return 0;
    direction=normalize(direction);
    float fa=(atan2(direction.x,direction.z)*57.29578+180)/2,fe=(asin(clamp(direction.y,-1.0,1.0))*57.29578+90)/2;
    int a=clamp((int)floor(fa),0,(int)PATH_ITD_AZIMUTHS-2),e=clamp((int)floor(fe),0,(int)PATH_ITD_ELEVATIONS-2);
    float ta=saturate(fa-a),te=saturate(fe-e);
    float low=PathItd[e*PATH_ITD_AZIMUTHS+a]*(1-ta)+PathItd[e*PATH_ITD_AZIMUTHS+a+1]*ta,high=PathItd[(e+1)*PATH_ITD_AZIMUTHS+a]*(1-ta)+PathItd[(e+1)*PATH_ITD_AZIMUTHS+a+1]*ta;
    return low*(1-te)+high*te;
}
int PathHistoryAt,PathSlideOffset;
float PathRawDirectionEnergy(uint pair,uint d,uint k)
{
    float e=0;
    for(uint b=0;b<LATE_BANDS;b++)
    {
        uint cell=((pair*LATE_DIRECTIONS+d)*LATE_BANDS+b)*PathBinsCount+k;
        float x=(LateHistogram[2*(PathFixedOffset+cell)+1]+LateHistogram[2*(PathFixedOffset+cell)]/4294967296.0)/LateRays;
        if(x>0)e+=x;
    }
    return e;
}
float PathRawEnergy(uint pair,uint k)
{
    float e=0;
    for(uint d=0;d<LATE_DIRECTIONS;d++)for(uint b=0;b<LATE_BANDS;b++)
    {
        uint cell=((pair*LATE_DIRECTIONS+d)*LATE_BANDS+b)*PathBinsCount+k;
        float x=(LateHistogram[2*(PathFixedOffset+cell)+1]+LateHistogram[2*(PathFixedOffset+cell)]/4294967296.0)/LateRays;
        if(x>0)e+=x;
    }
    return e;
}
float PathRateMoment(uint pair,uint moment,uint k)
{
    uint cell=(pair*3+moment)*PathBinsCount+k;
    return ((float)(int)LateHistogram[PathRateOffset+2*cell+1]+LateHistogram[PathRateOffset+2*cell]/4294967296.0)/LateRays;
}
// PathReverb.SelectEchoes: in time order a bin with energy is an echo while its contributions share one arrival (at
// least two, one rate: variance <= mean^2, one direction: 1 - |u|^2 <= |u|^2); the first that is not ends the early part.
[numthreads(64,1,1)]
void PathSlideSelect(uint3 id:SV_DispatchThreadID)
{
    uint pair=id.x;if(pair>=AudioPairs)return;
    bool open=LateValid!=0 && PathPairActive(pair);uint end=0;
    for(uint k=0;k<PathBinsCount;k++)
    {
        float rate=0;uint echo=0;
        if(open)
        {
            float e=PathRawEnergy(pair,k);
            if(e>0)
            {
                bool slide=PathDoppler!=0 && PathDelayMoments!=0;
                float mean=slide?PathRateMoment(pair,0,k)/e:0,variance=slide?PathRateMoment(pair,1,k)/e-mean*mean:0;
                float e0=PathRawDirectionEnergy(pair,0,k),e1=PathRawDirectionEnergy(pair,1,k),e2=PathRawDirectionEnergy(pair,2,k),e3=PathRawDirectionEnergy(pair,3,k),e4=PathRawDirectionEnergy(pair,4,k),e5=PathRawDirectionEnergy(pair,5,k);
                float total=e0+e1+e2+e3+e4+e5;
                float3 u=total>0?float3(sqrt(e0)-sqrt(e1),sqrt(e2)-sqrt(e3),sqrt(e4)-sqrt(e5))/sqrt(total):0;
                float u2=dot(u,u);
                if(PathBinCounts[PathCountOffset+pair*PathBinsCount+k]>=2 && variance<=mean*mean && 1-u2<=u2)
                {
                    rate=mean;echo=1;end=k+1;
                    float tau=PathBinStarts[k]+(PathDelayMoments!=0?PathRateMoment(pair,2,k)/e*AudioRate:.5*(PathBinStarts[k+1]-PathBinStarts[k])),half=0;
                    if(AudioChannels==2)half=.5*AudioRate*PathInterauralDelay(u);
                    for(uint c0=0;c0<AudioChannels;c0++)PathSlideDelays[((LateBank*AudioPairs+pair)*PathBinsCount+k)*AudioChannels+c0]=AudioChannels==2?(c0==0?tau+half:tau-half):tau;
                    for(uint c=0;c<AudioChannels;c++)for(uint b=0;b<LATE_BANDS;b++)
                    {float x=PathEarEnergy(pair,c,b,k);PathSlideAmplitudes[(((LateBank*AudioPairs+pair)*PathBinsCount+k)*AudioChannels+c)*LATE_BANDS+b]=x>0?sqrt(x):0;}
                }
                else open=false;
            }
        }
        PathSlideRates[(LateBank*AudioPairs+pair)*PathBinsCount+k]=rate;
        PathSlideEchoes[(LateBank*AudioPairs+pair)*PathBinsCount+k]=echo;
    }
    PathSlideEnd[LateBank*AudioPairs+pair]=end;
}
// Per group, band and channel: the slot energy (the group's histogram bins, ear-weighted) and its two sequences'
// weights. The first AudioPairs threads also record which pairs are active for the convolution's kernels.
[numthreads(64,1,1)]
void PathGroups(uint3 id:SV_DispatchThreadID)
{
    if(id.x<AudioPairs)LateActive[LateBank*AudioPairs+id.x]=PathPairActive(id.x)?1:0;
    uint g=id.x%PathGroupTotal,b=(id.x/PathGroupTotal)%LATE_BANDS,c=id.x/(PathGroupTotal*LATE_BANDS);if(c>=AudioChannels)return;
    uint4 info=PathGroupInfo[g];
    float2 w=0;
    if(PathPairActive(info.x))
    {
        // (An echo's energy is its impulse's, PathSlide; the kernel keeps the rest, as PathReverb.SetResponse.)
        float slot=0;
        for(uint i=0;i<info.w;i++){uint k=PathTermBins[info.z+i];if(PathSlideEchoesRead[(LateBank*AudioPairs+info.x)*PathBinsCount+k]==0)slot+=PathEarEnergy(info.x,c,b,k)*PathTermWeights[info.z+i];}
        if(slot>0)
        {
            float amplitude=sqrt(slot),a1=PathAlphaBeta[b].x,a2=AudioChannels==2?(c==0?PathAlphaBeta[b].y:-PathAlphaBeta[b].y):0;
            uint o=(g*LATE_BANDS+b)*3;
            w=amplitude*float2(a1*PathMix[o]+a2*PathMix[o+1],a1*PathMix[o+1]+a2*PathMix[o+2]);
        }
    }
    PathCoefficients[(c*LATE_BANDS+b)*PathGroupTotal+g]=w;
}
// One group per source and band: the band-filtered input of the current block (PathReverb.EnsureHistory), from the
// block's input spectrum (LateInput): band filter, inverse transform, the second half into the ring.
[numthreads(256,1,1)]
void PathBandInput(uint3 group:SV_GroupID,uint3 tid:SV_GroupThreadID)
{
    uint source=group.x/LATE_BANDS,b=group.x%LATE_BANDS,t=tid.x,size=2*LatePartition,ring=LateBlock%LateCount;
    for(uint k=t;k<LateBins;k+=256)
    {
        float2 x=AudioMultiply(LateInputs[(source*LateCount+ring)*LateBins+k],PathFilters[b*size+k]);
        AudioShared[k]=x;if(k>0 && k<LatePartition)AudioShared[size-k]=float2(x.x,-x.y);
    }
    GroupMemoryBarrierWithGroupSync();
    AudioFftShared(size,true,t);
    for(uint n=t;n<LatePartition;n+=256)PathBandHistory[(source*LATE_BANDS+b)*PathHistoryLength+(uint)((PathHistoryAt+(int)n)&(int)(PathHistoryLength-1))]=AudioShared[LatePartition+n].x;
}
static const float PATH_PI=3.14159265358979;
float PathSinc(float x){return abs(x)<1e-6?1:sin(PATH_PI*x)/(PATH_PI*x);}
// One thread per lane and sample of the block: bank (LateBank ^ LateWhich)'s echoes (PathReverb.SlideBlock), each an
// impulse at the time-varying delay tau + r (t - t_ref) into the band-filtered input, read with the direct path's filter,
// with its band amplitudes. Added to the bank's block after LateInverse, before PathPowers. PathHistoryAt: the block's
// t - latency in the ring.
[numthreads(64,1,1)]
void PathSlide(uint3 id:SV_DispatchThreadID)
{
    uint lanes=AudioListeners*AudioChannels,n=id.x%LatePartition,lane=id.x/LatePartition;if(lane>=lanes)return;
    uint listener=lane/AudioChannels,c=lane%AudioChannels,bank=LateBank^LateWhich,mask=PathHistoryLength-1;
    float value=0;bool any=false;
    for(uint pair=listener;pair<AudioPairs;pair+=AudioListeners)
    {
        if(LateActive[bank*AudioPairs+pair]==0)continue;uint source=pair/AudioListeners,bins=(bank*AudioPairs+pair)*PathBinsCount;
        for(uint k=0;k<PathSlideEnd[bank*AudioPairs+pair];k++)
        {
            if(PathSlideEchoesRead[bins+k]==0)continue;float r=PathSlideRates[bins+k];
            any=true;
            float cutoff=PathSincFilter!=0?min(1.0,1.0/(1.0-r)):1;int extent=PathSincFilter!=0?(int)ceil(PathSincRadius/cutoff):1;
            float u=(float)(PathHistoryAt+(int)n)-max((float)extent,PathSlideDelays[(bins+k)*AudioChannels+c]+r*(float)(PathSlideOffset+(int)n));
            int center=(int)floor(u);float phase=u-center;
            float acc[8];for(uint b0=0;b0<LATE_BANDS;b0++)acc[b0]=0;
            float sum=0;
            if(PathSincFilter==0)
            {
                for(uint b1=0;b1<LATE_BANDS;b1++)
                {
                    uint row=(source*LATE_BANDS+b1)*PathHistoryLength;
                    acc[b1]=PathBandHistory[row+((uint)center&mask)]*(1-phase)+PathBandHistory[row+((uint)(center+1)&mask)]*phase;
                }
                sum=1;
            }
            else for(int j=1-extent;j<=extent;j++)
            {
                float x=(j-phase)*cutoff;if(abs(x)>=(float)PathSincRadius)continue;
                float w=PathSinc(x)*PathSinc(x/PathSincRadius)*cutoff;sum+=w;uint at=(uint)(center+j)&mask;
                for(uint b2=0;b2<LATE_BANDS;b2++)acc[b2]+=w*PathBandHistory[(source*LATE_BANDS+b2)*PathHistoryLength+at];
            }
            for(uint b3=0;b3<LATE_BANDS;b3++)value+=PathSlideAmplitudes[((bins+k)*AudioChannels+c)*LATE_BANDS+b3]*acc[b3]/sum;
        }
    }
    if(any)LateBlocks[(LateWhich*lanes+lane)*LatePartition+n]+=value;
}
// Room modes (RoomModes.Synthesize is the CPU reference): per pair inside the bank's room, the modal difference
// dh = W_m (h_modal - h_direct). RoomModeSynthesis samples h_modal at the decimated rate over the kernel; RoomModeFft
// (radix-2 Stockham, one stage per dispatch, ping-pong) transforms it; RoomModeCross applies W_m and subtracts the
// direct pulse (its spectrum, exact); the inverse transform follows; RoomModeAdd interpolates dh to the output rate with
// the renderer's windowed sinc and adds it to both ears' filtered partitions (between PathFilter and PathPieces), at
// the band FIRs' delay: kernel sample round(t rate) + P/2.
StructuredBuffer<float4> RoomModeTable;         // [mode]: decay per sample, the poles' difference per sample (overdamped), 1/w_d or 1/rate, overdamped
StructuredBuffer<uint> RoomModePhases;          // [mode]: phase step, 32-bit fixed-point cycles
StructuredBuffer<float> RoomModeAmplitudes;     // [response slot][pair][mode]: 4 pi c^2 psi(s) psi(r)
StructuredBuffer<uint4> RoomModePairs;          // [response slot][pair]: active, direct gain x decimated rate (float bits), direct phase per bin (fixed)
StructuredBuffer<float> RoomModeWeights;        // [N/2 + 1]: W_m at the decimated transform's bins
StructuredBuffer<float> RoomModeInterpolation;  // [n % ratio][2 radius]: the windowed sinc's normalised taps (RoomModes.Interpolation)
RWStructuredBuffer<float2> RoomModeSource,RoomModeTarget;   // [pair][N]
uint RoomModeCount,RoomModeLength,RoomModeSize,RoomModeStage,RoomModeInverse,RoomModeRatio,RoomModeRadius;
float RoomModeScale;                            // 1 / (N x output rate): the inverse transform's 1/N, and kernel samples
static const float ROOM_MODE_CYCLE=2.3283064365386963e-10;   // 2^-32
bool RoomModeActive(uint pair){if(pair>=AudioPairs)return false;return RoomModePairs[RoomModeOffset*AudioPairs+pair].x!=0;}
[numthreads(64,1,1)]
void RoomModeSynthesis(uint3 id:SV_DispatchThreadID)
{
    uint pair=id.x/RoomModeSize,j=id.x%RoomModeSize;if(!RoomModeActive(pair))return;
    float v=0,t=(float)j;
    if(j<RoomModeLength)for(uint n=0;n<RoomModeCount;n++)
    {
        float a=RoomModeAmplitudes[(RoomModeOffset*AudioPairs+pair)*RoomModeCount+n];if(a==0)continue;
        float4 m=RoomModeTable[n];
        if(m.w!=0){float x=m.y*t;v+=a*m.z*exp(-m.x*t)*t*(x<.01?1-x/2+x*x/6:(1-exp(-x))/x);}   // RoomModes.Phi
        else v+=a*m.z*exp(-m.x*t)*sin(2*PATH_PI*(float)(RoomModePhases[n]*j)*ROOM_MODE_CYCLE);
    }
    RoomModeTarget[pair*RoomModeSize+j]=float2(v,0);
}
[numthreads(64,1,1)]
void RoomModeFft(uint3 id:SV_DispatchThreadID)
{
    uint halfSize=RoomModeSize/2,pair=id.x/halfSize,j=id.x%halfSize;if(!RoomModeActive(pair))return;
    uint ns=RoomModeStage,k=j%ns,origin=pair*RoomModeSize;
    float2 v0=RoomModeSource[origin+j],v1=RoomModeSource[origin+j+halfSize];
    float angle=(RoomModeInverse!=0?PATH_PI:-PATH_PI)*(float)k/(float)ns;
    v1=AudioMultiply(v1,float2(cos(angle),sin(angle)));
    uint o=origin+(j/ns)*2*ns+k;
    RoomModeTarget[o]=v0+v1;RoomModeTarget[o+ns]=v0-v1;
}
[numthreads(64,1,1)]
void RoomModeCross(uint3 id:SV_DispatchThreadID)
{
    uint pair=id.x/RoomModeSize,k=id.x%RoomModeSize;if(!RoomModeActive(pair))return;
    int kk=k<=RoomModeSize/2?(int)k:(int)k-(int)RoomModeSize;uint4 p=RoomModePairs[RoomModeOffset*AudioPairs+pair];
    float phase=-2*PATH_PI*(float)(p.z*(uint)kk)*ROOM_MODE_CYCLE;
    float2 x=RoomModeTarget[pair*RoomModeSize+k]-asfloat(p.y)*float2(cos(phase),sin(phase));
    RoomModeTarget[pair*RoomModeSize+k]=RoomModeWeights[abs(kk)]*x;
}
[numthreads(64,1,1)]
void RoomModeAdd(uint3 id:SV_DispatchThreadID)
{
    uint total=LateCount*LatePartition,pair=id.x/total,T=id.x%total;if(!RoomModeActive(pair))return;
    int n=(int)T-(int)(LatePartition/2);if(n<0)return;   // (the precursor before emission is dropped, as on the CPU)
    uint taps=2*RoomModeRadius,o=((uint)n%RoomModeRatio)*taps;int first=n/(int)RoomModeRatio-(int)RoomModeRadius+1;float sum=0;
    for(uint i=0;i<taps;i++)sum+=RoomModeInterpolation[o+i]*RoomModeSource[pair*RoomModeSize+(uint)(first+(int)i+(int)RoomModeSize)%RoomModeSize].x;
    float v=sum*RoomModeScale;
    uint at=(pair*LateCount+T/LatePartition)*2*LatePartition+T%LatePartition;
    float2 x=PathFiltered[at];x.x+=v;if(AudioChannels==2)x.y+=v;PathFiltered[at]=x;
}
// A partition through the band FFTs: sum over bands of FFT(band slot sequences) x band filter, then the inverse.
void PathBandPartition(uint entry,uint t)
{
    uint p=entry%LateCount,pair=entry/LateCount,size=2*LatePartition,per=size/256;
    float2 sum[8];
    for(uint i=0;i<8;i++)sum[i]=0;
    for(uint b=0;b<LATE_BANDS;b++)
    {
        for(uint n=t;n<size;n+=256)
        {
            float2 v=0;
            if(n<LatePartition)
            {
                uint at=pair*LateCount*LatePartition+p*LatePartition+n;int g=PathSampleGroup[at];
                if(g>=0)
                {
                    float2 s=PathSampleValues[at];
                    v.x=dot(PathCoefficients[b*PathGroupTotal+g],s);
                    if(AudioChannels==2)v.y=dot(PathCoefficients[(LATE_BANDS+b)*PathGroupTotal+g],s);
                }
            }
            AudioShared[n]=v;
        }
        GroupMemoryBarrierWithGroupSync();
        AudioFftShared(size,false,t);
        for(uint j=0;j<per;j++){uint k=t+256*j;sum[j]+=AudioMultiply(AudioShared[k],PathFilters[b*size+k]);}
        GroupMemoryBarrierWithGroupSync();
    }
    for(uint j=0;j<per;j++)AudioShared[t+256*j]=sum[j];
    GroupMemoryBarrierWithGroupSync();
    AudioFftShared(size,true,t);
    for(uint n=t;n<size;n+=256)PathFiltered[(pair*LateCount+p)*size+n]=AudioShared[n];
}
// A partition through its groups' spectra: the same filtered partition as PathBandPartition, summed in the frequency
// domain from the groups' fixed spectra (PathReverb's own, the zero-padded FFTs of their two slot sequences) instead of
// eight band FFTs. Real signals: bins above P mirror. Used where it takes fewer operations (GpuAudio.EnsurePath).
StructuredBuffer<uint4> PathSpectralPartitions;  // pair * count + partition, first entry in PathSpectralGroups, groups, first spectrum slot
StructuredBuffer<uint> PathSpectralGroups;       // the groups of each spectral partition, in order
StructuredBuffer<float2> PathGroupSpectra;       // [slot][sequence 2][P + 1], a partition's groups in consecutive slots
void PathSpectralPartition(uint4 entry,uint t)
{
    uint p=entry.x%LateCount,pair=entry.x/LateCount,size=2*LatePartition,bins=LatePartition+1;
    for(uint k=t;k<bins;k+=256)
    {
        float2 y0=0,y1=0;
        for(uint j=0;j<entry.z;j++)
        {
            uint g=PathSpectralGroups[entry.y+j],slot=entry.w+j;
            float2 s1=PathGroupSpectra[(slot*2)*bins+k],s2=PathGroupSpectra[(slot*2+1)*bins+k];
            for(uint b=0;b<LATE_BANDS;b++)
            {
                float2 h=PathFilters[b*size+k],w=PathCoefficients[b*PathGroupTotal+g];
                y0+=AudioMultiply(h,w.x*s1+w.y*s2);
                if(AudioChannels==2){float2 v=PathCoefficients[(LATE_BANDS+b)*PathGroupTotal+g];y1+=AudioMultiply(h,v.x*s1+v.y*s2);}
            }
        }
        // Packed ears z = y0 + i y1, over all 2P bins (the upper half from the conjugates of the real signals' spectra).
        AudioShared[k]=float2(y0.x-y1.y,y0.y+y1.x);
        if(k>0 && k<LatePartition)AudioShared[size-k]=float2(y0.x+y1.y,-y0.y+y1.x);
    }
    GroupMemoryBarrierWithGroupSync();
    AudioFftShared(size,true,t);
    for(uint n=t;n<size;n+=256)PathFiltered[(pair*LateCount+p)*size+n]=AudioShared[n];
}
// One dispatch for both kinds: the first PathFftDispatch groups take a partition through the band FFTs, the rest
// spectral partitions from PathSpectralFirst on (each group follows one branch, so its barriers stay uniform).
uint PathFftDispatch,PathSpectralFirst;
[numthreads(256,1,1)]
void PathFilter(uint3 group:SV_GroupID,uint3 tid:SV_GroupThreadID)
{
    if(group.x<PathFftDispatch)PathBandPartition(PathFftPartitions[group.x],tid.x);
    else PathSpectralPartition(PathSpectralPartitions[PathSpectralFirst+group.x-PathFftDispatch],tid.x);
}
// One group per pair and partition: the partition's piece (its filtered first half plus the previous one's
// second half), transformed; the packed channels are separated by conjugate symmetry.
[numthreads(256,1,1)]
void PathPieces(uint3 group:SV_GroupID,uint3 tid:SV_GroupThreadID)
{
    uint p=group.x%LateCount,pair=group.x/LateCount,t=tid.x,size=2*LatePartition;
    for(uint n=t;n<size;n+=256)
    {
        float2 v=0;
        if(n<LatePartition)
        {
            v=PathFiltered[(pair*LateCount+p)*size+n];
            if(p>0)v+=PathFiltered[(pair*LateCount+p-1)*size+LatePartition+n];
        }
        AudioShared[n]=v;
    }
    GroupMemoryBarrierWithGroupSync();
    AudioFftShared(size,false,t);
    uint count=AudioPairs*AudioChannels*LateCount*LateBins;
    for(uint k=t;k<LateBins;k+=256)
    {
        float2 z=AudioShared[k],m=AudioShared[(size-k)%size];m.y=-m.y;
        float2 k0=(z+m)*.5,k1=float2(z.y-m.y,m.x-z.x)*.5;   // (z + conj m) / 2 and (z - conj m) / 2i
        LateKernels[LateBank*count+((pair*AudioChannels)*LateCount+p)*LateBins+k]=k0;
        if(AudioChannels==2)LateKernels[LateBank*count+((pair*AudioChannels+1)*LateCount+p)*LateBins+k]=k1;
    }
}
// Powers of both banks' blocks per lane (PathReverb.Compute), for LateWrite's power-corrected crossfade.
[numthreads(256,1,1)]
void PathPowers(uint3 group:SV_GroupID,uint3 tid:SV_GroupThreadID)
{
    uint lane=group.x,t=tid.x,lanes=AudioListeners*AudioChannels;
    float pa=0,po=0,cross=0;
    for(uint n=t;n<LatePartition;n+=256){float x=LateBlocks[lane*LatePartition+n],y=LateBlocks[(lanes+lane)*LatePartition+n];pa+=x*x;po+=y*y;cross+=x*y;}
    AudioShared[t]=float2(pa,po);AudioShared[256+t]=float2(cross,0);
    GroupMemoryBarrierWithGroupSync();
    for(uint s=128;s>0;s>>=1)
    {
        if(t<s){AudioShared[t]+=AudioShared[t+s];AudioShared[256+t]+=AudioShared[256+t+s];}
        GroupMemoryBarrierWithGroupSync();
    }
    if(t==0){LatePowers[3*lane]=AudioShared[0].x;LatePowers[3*lane+1]=AudioShared[0].y;LatePowers[3*lane+2]=AudioShared[256].x;}
}
