float4 AudioSum(uint channel,uint bin,bool moving,uint tile)
{
    uint listener=channel/AudioChannels,ear=channel%AudioChannels;float4 value=0;
    for(uint pair=listener;pair<AudioPairs;pair+=AudioListeners)if(AudioFilterPairs[pair]>=0)
    {
