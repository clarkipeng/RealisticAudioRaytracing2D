        AudioPath q=AudioPaths[other*AudioCapacity+match],left=p,right=q;
        if(AudioWhich==0){left=q;right=p;}
        float span=AudioDifference(uint2(AudioMeta[19],AudioMeta[20]),uint2(AudioMeta[17],AudioMeta[18]));
        float time=AudioDifference(AudioBlockSample,uint2(AudioMeta[17],AudioMeta[18]))+local;
        delay=AudioProduct(left.delaySeconds,AudioRate);rate=left.direction.w;correction=AudioProduct(rate,time);
        if(time>=span){delay=AudioProduct(right.delaySeconds,AudioRate);rate=right.direction.w;correction=AudioProduct(rate,time-span);}
