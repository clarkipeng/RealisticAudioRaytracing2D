            float2 filtered=AudioMultiply(AudioWork[g*AudioWorkStride+bin],AudioFilters[AudioFilterAt(bank,g)+bin]);
            value.xy+=AudioMultiply(filtered,AudioEar(AudioBlends[g],ear,bin));
            if(moving)value.zw+=AudioMultiply(filtered,AudioEar(AudioBlends[AudioCapacity+g],ear,bin));
        }
    }
    return value;
}
// Each tile sums disjoint paths in a fixed order; the IFFT reduces the tiles.
// Tiles distribute work only: every active path and frequency is retained.
[numthreads(64,1,1)]
void AudioSumTiles(uint3 id:SV_DispatchThreadID)
{
    if(id.x>=AudioBins || AudioOldOff())return;
    uint channel=id.z,tile=id.y;
    AudioSums[(channel*AudioTiles+tile)*AudioBins+id.x]=AudioSum(channel,id.x,AudioMovingHead(channel/AudioChannels),tile);
}
float4 AudioReducedSum(uint channel,uint bin)
{
    float4 value=0;
    for(uint tile=0;tile<AudioTiles;tile++)value+=AudioSums[(channel*AudioTiles+tile)*AudioBins+bin];
    return value;
}
[numthreads(256,1,1)]
void AudioInverse(uint3 group:SV_GroupID,uint3 tid:SV_GroupThreadID)
{
    if(tid.x==0)AudioSkip=AudioOldOff()?1:0;GroupMemoryBarrierWithGroupSync();
    if(AudioSkip!=0)return;uint channel=group.x,t=tid.x;
    bool moving=AudioMovingHead(channel/AudioChannels);
    // Pack two real ear outputs into one complex IFFT: Z=A+iB.
    for(uint k=t;k<AudioBins;k+=256)
    {
        float4 sum=AudioReducedSum(channel,k);float2 a=sum.xy,b=sum.zw;
        if(k==0 || k==AudioFft/2){a.y=0;b.y=0;}
        AudioShared[k]=float2(a.x-b.y,a.y+b.x);
        if(k>0 && k<AudioFft/2)AudioShared[AudioFft-k]=float2(a.x+b.y,-a.y+b.x);
    }
    GroupMemoryBarrierWithGroupSync();
    AudioFftShared(AudioFft,true,t);
    for(uint n=t;n<AudioHop;n+=256){float2 v=AudioShared[AudioFft-AudioHop+n];AudioBlocks[(AudioWhich*AudioListeners*AudioChannels+channel)*AudioHop+n]=moving?lerp(v.x,v.y,n/(float)AudioHop):v.x;}
}
[numthreads(64,1,1)]
void AudioWrite(uint3 id:SV_DispatchThreadID)
{
    uint i=id.x,channels=AudioListeners*AudioChannels;if(i>=AudioWriteCount*channels)return;
    uint n=i/channels,c=i%channels;float blend=AudioMeta[2]==0?1:saturate((AudioDifference(AudioBlockSample,uint2(AudioMeta[3],AudioMeta[4]))+(int)AudioWriteAt+(int)n)/(float)AudioMeta[2]);
    if(AudioSpectral!=0)
    {
        int span=AudioDifference(uint2(AudioMeta[19],AudioMeta[20]),uint2(AudioMeta[17],AudioMeta[18]));
        int time=AudioDifference(AudioBlockSample,uint2(AudioMeta[17],AudioMeta[18]))+(int)AudioWriteAt+(int)n-AudioLatency-(int)AudioSize/2;
        blend=AudioMeta[2]==0 || span<=0?1:AudioMeta[21]!=0?(time<span?0:1):saturate(time/(float)span);
    }
    uint at=c*AudioHop+AudioWriteAt+n;float value=AudioBlocks[at]*blend;
    if(blend<1)value+=AudioBlocks[channels*AudioHop+at]*(1-blend);
    if(!isfinite(value))AudioError(3);
    AudioOutput[8+AudioWriteOffset*channels+i]=value;
    if(i==0)
    {
        AudioMeta[14]=max(AudioMeta[14],AudioMeta[13]);
        AudioOutput[0]=(float)AudioMeta[10];AudioOutput[1]=(float)AudioMeta[9];
        // Preserve integer counter bits, including wraparound, in the existing PCM readback.
        for(uint k=0;k<4;k++)AudioOutput[2+k]=asfloat(AudioMeta[11+k]);
        AudioOutput[6]=asfloat(AudioMeta[15]);AudioOutput[7]=asfloat(AudioMeta[16]);
    }
}
// No transform-size cap: global FFT stages are the fallback above shared memory.
[numthreads(256,1,1)]
void AudioMaterialGlobal(uint3 group:SV_GroupID,uint3 tid:SV_GroupThreadID)
{
    if(AudioPairState[AudioPair].z==0)return;uint g=AudioPair*AudioSlots+group.x;
    for(uint k=tid.x;k<AudioSize;k+=256){uint bin=min(k,AudioSize-k);float2 gain=0;int i=AudioHeads[g];for(uint visit=0;visit<AudioSlots && i>=0;visit++){AudioPath p=AudioArrivals[AudioOffset+i];if(p.frequencyBin==bin)gain+=float2(p.pressureGain,p.pressureImag);i=AudioNext[i];}if(i>=0)AudioError(4);if(k==0 || k==AudioSize/2)gain.y=0;else if(k>AudioSize/2)gain.y=-gain.y;AudioTransform[group.x*AudioFft+k]=gain;}
}
[numthreads(256,1,1)]
void AudioPadGlobal(uint3 group:SV_GroupID,uint3 tid:SV_GroupThreadID)
{
    if(AudioPairState[AudioPair].z==0)return;uint g=AudioPair*AudioSlots+group.x;
    for(uint n=tid.x;n<AudioFft;n+=256)AudioWork[g*AudioFft+n]=n<AudioSize?float2(AudioTransform[group.x*AudioFft+(n+AudioSize/2)%AudioSize].x,0):0;
}
[numthreads(256,1,1)]
void AudioFilterGlobal(uint3 group:SV_GroupID,uint3 tid:SV_GroupThreadID)
{
    if(AudioPairState[AudioPair].z==0)return;uint g=AudioPair*AudioSlots+group.x;
    for(uint k=tid.x;k<AudioBins;k+=256)AudioFilters[AudioFilterAt(AudioPairState[AudioPair].x,g)+k]=AudioWork[g*AudioFft+k];
}
[numthreads(256,1,1)]
void AudioInputGlobal(uint3 group:SV_GroupID,uint3 tid:SV_GroupThreadID)
{
    if(AudioOldOff())return;uint g=AudioPair*AudioSlots+group.x;if(tid.x==0)AudioPrepareHead(g);if(AudioReuseInput(g))return;
    if(tid.x==0)InterlockedAdd(AudioMeta[16],1);
    for(uint n=tid.x;n<AudioFft;n+=256)AudioWork[g*AudioFft+n]=float2(AudioSample(g,n),0);
}
[numthreads(256,1,1)]
void AudioSumGlobal(uint3 group:SV_GroupID,uint3 tid:SV_GroupThreadID)
{
    if(AudioOldOff())return;uint channel=group.x;
    for(uint k=tid.x;k<AudioFft;k+=256)
    {
        uint bin=min(k,AudioFft-k);float4 sum=AudioReducedSum(channel,bin);float2 a=sum.xy,b=sum.zw;
        if(bin==0 || bin==AudioFft/2){a.y=0;b.y=0;}if(k>AudioFft/2){a.y=-a.y;b.y=-b.y;}
        AudioTransform[channel*AudioFft+k]=float2(a.x-b.y,a.y+b.x);
    }
}
[numthreads(256,1,1)]
void AudioSaveGlobal(uint3 group:SV_GroupID,uint3 tid:SV_GroupThreadID)
{
    if(AudioOldOff())return;uint channel=group.x;bool moving=AudioMovingHead(channel/AudioChannels);
    for(uint n=tid.x;n<AudioHop;n+=256){float2 v=AudioTransform[channel*AudioFft+AudioFft-AudioHop+n];AudioBlocks[(AudioWhich*AudioListeners*AudioChannels+channel)*AudioHop+n]=moving?lerp(v.x,v.y,n/(float)AudioHop):v.x;}
}
bool AudioSkipTransform(uint g) {return AudioBuildingFilter!=0?AudioPairState[AudioPair].z==0:AudioOldOff() || (AudioTransformInput!=0 && AudioReuseInput(g));}
[numthreads(256,1,1)]
void AudioBitReverse(uint3 group:SV_GroupID,uint3 tid:SV_GroupThreadID)
{
    uint g=AudioTransformBase+group.x,n=AudioTransformSize,bits=(uint)firstbithigh(n);if(AudioSkipTransform(g))return;
    for(uint i=tid.x;i<n;i+=256){uint j=reversebits(i)>>(32-bits);if(j>i){float2 a=AudioTransform[g*AudioFft+i];AudioTransform[g*AudioFft+i]=AudioTransform[g*AudioFft+j];AudioTransform[g*AudioFft+j]=a;}}
}
[numthreads(256,1,1)]
void AudioButterfly(uint3 group:SV_GroupID,uint3 tid:SV_GroupThreadID)
{
    uint g=AudioTransformBase+group.x,n=AudioTransformSize,step=AudioStage;if(AudioSkipTransform(g))return;
    for(uint i=tid.x;i<n/2;i+=256)
    {
        uint k=i%(step/2),at=g*AudioFft+(i/(step/2))*step+k;float angle=(AudioTransformInverse!=0?2:-2)*AUDIO_PI*k/step;
        float2 a=AudioTransform[at],b=AudioMultiply(AudioTransform[at+step/2],float2(cos(angle),sin(angle)));
        float scale=AudioTransformInverse!=0 && step==n?1.0/n:1;
        AudioTransform[at]=(a+b)*scale;AudioTransform[at+step/2]=(a-b)*scale;
    }
}
