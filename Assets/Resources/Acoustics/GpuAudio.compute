    int local=(int)n-(int)(AudioFft-AudioHop)-AudioLatency;
    uint anchor=AudioSpectral!=0?(AudioWhich==0?19:17):5+AudioBank()*2;
    int delta=AudioDifference(AudioBlockSample,uint2(AudioMeta[anchor],AudioMeta[anchor+1]))+local;
    float rate=AudioSpectral!=0?p.direction.w:0;
    float2 delay=AudioProduct(p.delaySeconds,AudioRate),correction=AudioProduct(rate,delta);
    int match=AudioMatches[bank*AudioCapacity+g];
