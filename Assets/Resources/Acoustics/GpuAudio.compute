// Path method (PathReverb.cs is the CPU reference): per update, per impulse group the two sequences' weights (from
// the ear energies of the group's histogram bins), then per partition the kernel: each band's slot sequences filtered
// by its band FIR and summed over bands (both channels packed as real and imaginary parts), overlap-added across
// partitions and transformed into LateKernels. The convolution, crossfade and output are the late field's (LateInput
// with the band filters' delay as LateAdvance, LateSum, LateInverse, LateWrite with LatePower).
StructuredBuffer<float> PathHistogram;          // denoised [pair][6][8][bin] (PathFloat), else LateHistogram as fixed point
StructuredBuffer<float> PathEarWeights;         // [direction][2][band]
StructuredBuffer<float2> PathAlphaBeta;         // [band]
StructuredBuffer<uint4> PathGroupInfo;          // [group]: pair, partition, first term, terms
StructuredBuffer<uint> PathTermBins;
StructuredBuffer<float> PathTermWeights,PathMix; // mix [group][band][3]
StructuredBuffer<int> PathSampleGroup;          // [pair][count * P]
StructuredBuffer<float2> PathSampleValues;
StructuredBuffer<float2> PathFilters;           // [band][2P]
RWStructuredBuffer<float2> PathCoefficients;    // [channel][band][group]
RWStructuredBuffer<float2> PathFiltered;        // [pair][partition][2P]: both channels' filtered partition
StructuredBuffer<uint> PathFftPartitions;        // pair * count + partition, for the band FFTs
uint PathFloat,PathGroupTotal,PathBinsCount,PathFixedOffset;
// Room modes (RoomModes.cs): per pair and band the share g_b of the histogram's energy left to the path method (1
// outside the bank's room).
