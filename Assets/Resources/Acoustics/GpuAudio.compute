// CPU and GPU exchange scene inputs and finished PCM. Paths, filters, FFTs and
// sums stay here. The small-transform fast path uses one workgroup per path;
// larger transforms use the same radix-2 operations in global-memory stages.
struct AudioPath { float4 direction; float delaySeconds,pressureGain; uint frequencyBin,identity; float pressureImag; uint padding0,padding1,padding2; };
StructuredBuffer<AudioPath> AudioArrivals;
RWStructuredBuffer<AudioPath> AudioLast,AudioPaths;
RWStructuredBuffer<int2> AudioTable;
RWStructuredBuffer<int> AudioHeads,AudioNext,AudioMatches;
RWStructuredBuffer<uint> AudioMeta,AudioCounts,AudioArgs;
RWStructuredBuffer<uint4> AudioPairState; // current bank, previous bank, rebuild, listener activity
StructuredBuffer<float4> AudioHeadsPose,AudioRings;
RWStructuredBuffer<float4> AudioHeadHistory;
StructuredBuffer<float2> AudioAngles,AudioEars;
StructuredBuffer<float> AudioSource;
StructuredBuffer<int> AudioFilterPairs;
RWStructuredBuffer<float4> AudioSums;
RWStructuredBuffer<float2> AudioFilters,AudioWork,AudioTransform;
RWStructuredBuffer<float> AudioBlocks,AudioOutput;
struct EarBlend { uint4 index; float4 weight; };
RWStructuredBuffer<EarBlend> AudioBlends;
uint AudioPairs,AudioListeners,AudioChannels,AudioSlots,AudioCapacity,AudioHashSize,AudioFilterCapacity,AudioTiles;
uint AudioSize,AudioFft,AudioBins,AudioHop,AudioRate,AudioHrir,AudioRingCount,AudioHistory;
uint AudioPoseOffset,AudioOffset,AudioChanged,AudioCut,AudioInitialized,AudioTransition,AudioSpectral;
uint2 AudioResponseSample,AudioSolveSample,AudioBlockSample;
uint AudioPair,AudioWhich,AudioRadius,AudioSinc;
int AudioLatency,AudioRingAt,AudioAvailableStart,AudioAvailableEnd;
uint AudioBlockNegative;
uint AudioWriteOffset,AudioWriteCount,AudioWriteAt;
uint AudioWorkStride,AudioTransformSize,AudioTransformBase,AudioTransformInverse,AudioStage,AudioBuildingFilter,AudioTransformInput;
float AudioMaximumDelay;
static const float AUDIO_PI=3.14159265358979323846;
static const uint AUDIO_SHARED=2048;
groupshared float2 AudioShared[AUDIO_SHARED];
groupshared uint AudioSkip;
groupshared uint AudioLocalTable[8191]; // Reserve the last uint of 32 KiB for AudioSkip; larger tables use global memory.

float2 AudioMultiply(float2 a,float2 b) {return float2(a.x*b.x-a.y*b.y,a.x*b.y+a.y*b.x);}
uint AudioHash(uint a) {a^=a>>16;a*=0x7feb352d;a^=a>>15;a*=0x846ca68b;return a^(a>>16);}
uint AudioBits(float a) {return a==0?0:asuint(a);}
bool AudioSame(AudioPath a,AudioPath b) {return a.delaySeconds==b.delaySeconds && all(a.direction==b.direction) && (AudioSpectral==0 || a.identity==b.identity);}
uint AudioBank() {return AudioMeta[0] ^ (AudioSpectral!=0?0:AudioWhich);}
// Acoustic ownership is per pair; the output/head clock still advances as one response.
uint AudioPathBank(uint pair) {return AudioWhich==0?AudioPairState[pair].x:AudioPairState[pair].y;}
uint AudioFilterAt(uint bank,uint g) {return (bank*AudioFilterCapacity+AudioFilterPairs[g/AudioSlots]*AudioSlots+g%AudioSlots)*AudioBins;}
bool AudioReuseInput(uint g) {uint4 pair=AudioPairState[g/AudioSlots];return AudioWhich!=0 && ((AudioSpectral!=0 && AudioMatches[pair.y*AudioCapacity+g]==(int)g) || (pair.x==pair.y && (AudioSpectral==0 || AudioPaths[pair.x*AudioCapacity+g].direction.w==0)));}
bool AudioOldOff() {return AudioWhich!=0 && AudioMeta[2]==0;}
int AudioDifference(uint2 a,uint2 b) {return (int)(a.x-b.x);} // Local differences only; absolute sample clocks remain integers.
float3 AudioRotate(float4 q,float3 v) {return v+2*cross(q.xyz,cross(q.xyz,v)+q.w*v);}
void AudioError(uint code) {uint old;InterlockedCompareExchange(AudioMeta[10],0,code,old);}

[numthreads(64,1,1)]
void AudioReset(uint3 id:SV_DispatchThreadID) {if(id.x==0){AudioMeta[1]=0;AudioMeta[13]=0;}if(id.x<AudioPairs)AudioPairState[id.x].z=0;}
[numthreads(64,1,1)]
void AudioCompare(uint3 id:SV_DispatchThreadID)
{
    uint i=id.x;if(i>=AudioCapacity)return;if(AudioFilterPairs[i/AudioSlots]<0)return;
    AudioPath a=AudioArrivals[AudioOffset+i],b=AudioLast[i];
    if(!AudioSame(a,b) || a.pressureGain!=b.pressureGain || a.pressureImag!=b.pressureImag || a.frequencyBin!=b.frequencyBin){InterlockedOr(AudioMeta[1],1);InterlockedOr(AudioPairState[i/AudioSlots].z,1);}
    if(AudioSpectral!=0 && a.direction.w!=0)InterlockedOr(AudioMeta[1],2);
    AudioLast[i]=a;
}
[numthreads(1,1,1)]
void AudioCommit(uint3 id:SV_DispatchThreadID)
{
    uint changed=(AudioMeta[1]&1)|AudioChanged|(1-AudioInitialized)|(AudioSpectral*AudioCut);
    AudioMeta[11]++;if(changed==0)AudioMeta[12]++;
    AudioMeta[2]=AudioSpectral!=0?(AudioInitialized!=0 && (AudioMeta[1]|(AudioChanged&2)|AudioCut)!=0?1:0):changed!=0 && AudioInitialized!=0 && AudioCut==0?AudioTransition:0;
    AudioMeta[17]=AudioInitialized!=0?AudioMeta[19]:AudioSolveSample.x;AudioMeta[18]=AudioInitialized!=0?AudioMeta[20]:AudioSolveSample.y;
    AudioMeta[19]=AudioSolveSample.x;AudioMeta[20]=AudioSolveSample.y;AudioMeta[21]=AudioCut;AudioMeta[22]=AudioInitialized;
    AudioMeta[3]=AudioResponseSample.x;AudioMeta[4]=AudioResponseSample.y;
    if(changed!=0 || AudioSpectral!=0)
    {
        for(uint p=0;p<AudioPairs;p++)
        {
            uint4 pair=AudioPairState[p];uint active=AudioHeadsPose[AudioPoseOffset+AudioListeners+p%AudioListeners].x!=0?1:0;
            pair.z|=(pair.w!=active?1:0)|(1-AudioInitialized);pair.w=active;
            pair.y=pair.x;if(pair.z!=0)pair.x^=1;AudioPairState[p]=pair;
        }
        AudioMeta[0]^=1;uint at=5+AudioMeta[0]*2;
        AudioMeta[at]=AudioResponseSample.x;AudioMeta[at+1]=AudioResponseSample.y;
        for(uint i=0;i<AudioListeners*2;i++)AudioHeadHistory[AudioMeta[0]*AudioListeners*2+i]=AudioHeadsPose[AudioPoseOffset+i];
    }
}
float AudioRepeat(float a) {return a-floor(a/(2*AUDIO_PI))*(2*AUDIO_PI);}
void AudioAround(uint ring,float azimuth,out uint a,out uint b,out float t)
{
    uint offset=(uint)AudioRings[ring].y,count=(uint)AudioRings[ring].z,upper=0;
    while(upper<count && AudioAngles[offset+upper].x<azimuth)upper++;
    uint lower=(upper+count-1)%count;upper%=count;
    float2 x=AudioAngles[offset+lower],y=AudioAngles[offset+upper];a=(uint)x.y;b=(uint)y.y;
    float span=AudioRepeat(y.x-x.x);t=span==0?0:saturate(AudioRepeat(azimuth-x.x)/span);
}
EarBlend AudioBlend(float3 direction)
{
    EarBlend result=(EarBlend)0;if(AudioChannels==1){result.weight.x=1;return result;}
    direction=dot(direction,direction)<1e-12?float3(0,0,1):normalize(direction);
    float elevation=asin(clamp(direction.y,-1,1)),azimuth=atan2(direction.x,direction.z);uint upper=0;
    while(upper+1<AudioRingCount && AudioRings[upper].x<elevation)upper++;
    uint lower=upper==0?0:upper-1;float span=AudioRings[upper].x-AudioRings[lower].x;
    float t=span==0?0:saturate((elevation-AudioRings[lower].x)/span),x,y;
    AudioAround(lower,azimuth,result.index.x,result.index.y,x);AudioAround(upper,azimuth,result.index.z,result.index.w,y);
    result.weight=float4((1-t)*(1-x),(1-t)*x,t*(1-y),t*y);return result;
}
bool AudioMovingHead(uint listener) {return any(AudioHeadHistory[(AudioBank()*2+1)*AudioListeners+listener].yzw!=0);}
void AudioPrepareHead(uint g)
{
    uint bank=AudioBank(),listener=(g/AudioSlots)%AudioListeners,anchor=5+bank*2;
    float4 q=AudioHeadHistory[bank*2*AudioListeners+listener];q.xyz=-q.xyz;
    float3 omega=AudioHeadHistory[(bank*2+1)*AudioListeners+listener].yzw;
    float speed=length(omega);uint endpoints=speed>0?2:1;
    // Poses are anchored to output samples, before playback lead. Advance in
    // world space, then transform the incident ray into the listener's frame.
    for(uint end=0;end<endpoints;end++)
    {
        float3 direction=AudioPaths[AudioPathBank(g/AudioSlots)*AudioCapacity+g].direction.xyz;
        if(speed>0)
        {
            float dt=(AudioDifference(AudioBlockSample,uint2(AudioMeta[anchor],AudioMeta[anchor+1]))+end*AudioHop)/(float)AudioRate;
            float angle=speed*dt*.5;direction=AudioRotate(float4(-omega*(sin(angle)/speed),cos(angle)),direction);
        }
        AudioBlends[end*AudioCapacity+g]=AudioBlend(AudioRotate(q,direction));
    }
}
float2 AudioEar(EarBlend blend,uint ear,uint bin)
{
    if(AudioChannels==1)return float2(1,0);
    float2 value=0;for(uint k=0;k<4;k++)value+=AudioEars[(blend.index[k]*AudioChannels+ear)*AudioBins+bin]*blend.weight[k];return value;
}
// A table entry owns the group index and its last member. Comparisons read
// immutable arrivals; the GPU never follows a partially written path record.
int2 AudioLookup(uint pair,uint hash)
{
    if(AudioHashSize>8191)return AudioTable[pair*AudioHashSize+hash];
    uint packed=AudioLocalTable[hash];return packed==0xffffffff?int2(-1,-1):int2(packed&65535,packed>>16);
}
void AudioInsert(uint pair,uint hash,int group,int member)
{
    if(AudioHashSize<=8191)AudioLocalTable[hash]=(uint)group|((uint)member<<16);
    else {AudioTable[pair*AudioHashSize+hash]=int2(group,member);DeviceMemoryBarrier();}
}
[numthreads(64,1,1)]
void AudioGroups(uint3 id:SV_GroupID,uint3 tid:SV_GroupThreadID)
{
    uint pair=id.x;if(pair>=AudioPairs)return;uint bank=AudioPairState[pair].x,base=pair*AudioSlots;
    bool rebuild=AudioPairState[pair].z!=0 && AudioFilterPairs[pair]>=0;
    if(rebuild)
    {
        for(uint t=tid.x;t<AudioHashSize;t+=64)
            if(AudioHashSize<=8191)AudioLocalTable[t]=0xffffffff;else AudioTable[pair*AudioHashSize+t]=int2(-1,-1);
        // Reuse the future member links as temporary keys. Stable slot order is
        // restored below before those links are written; no floating atomics.
        for(uint slot=tid.x;slot<AudioSlots;slot+=64)
        {
            uint i=base+slot;AudioPath path=AudioArrivals[AudioOffset+i];AudioNext[i]=-1;
            if((path.pressureGain==0 && path.pressureImag==0) || AudioHeadsPose[AudioPoseOffset+AudioListeners+pair%AudioListeners].x==0)continue;
            if(!isfinite(path.pressureGain) || !isfinite(path.pressureImag) || !isfinite(path.delaySeconds) || !all(isfinite(path.direction)) || path.delaySeconds<0 || path.delaySeconds>AudioMaximumDelay || path.frequencyBin>AudioSize/2 || (AudioSpectral!=0 && path.direction.w>=1)) {AudioError(1);continue;}
            uint hash=AudioHash(AudioBits(path.delaySeconds));
            for(uint k=0;k<4;k++)hash=AudioHash(hash^AudioBits(path.direction[k]));
            if(AudioSpectral!=0)hash=AudioHash(hash^path.identity);
            AudioNext[i]=(int)(hash%AudioHashSize);
        }
    }
    AllMemoryBarrierWithGroupSync();if(tid.x!=0)return;
    if(rebuild)
    {
        uint count=0;
        for(uint slot=0;slot<AudioSlots;slot++)
        {
            uint i=base+slot;if(AudioNext[i]<0)continue;uint hash=(uint)AudioNext[i];
            AudioPath path=AudioArrivals[AudioOffset+i];
            int2 entry=int2(-1,-1);uint probes=0;
            for(;probes<AudioHashSize;probes++)
            {
                entry=AudioLookup(pair,hash);
                if(entry.x<0 || AudioSame(path,AudioArrivals[AudioOffset+base+entry.y]))break;
                hash=(hash+1)%AudioHashSize;
            }
            if(probes==AudioHashSize){AudioError(4);continue;}
            int group=entry.x;
            if(group<0){group=(int)count++;AudioPaths[bank*AudioCapacity+base+group]=path;}
            else if(path.frequencyBin<AudioPaths[bank*AudioCapacity+base+group].frequencyBin)AudioPaths[bank*AudioCapacity+base+group].frequencyBin=path.frequencyBin;
            AudioNext[i]=entry.y<0?-1:(int)base+entry.y;AudioHeads[base+group]=(int)i;
            AudioInsert(pair,hash,group,(int)slot);
        }
        DeviceMemoryBarrier();
        AudioCounts[bank*AudioPairs+pair]=count;InterlockedAdd(AudioMeta[15],count);
        for(uint g=0;g<count;g++)
        {
            AudioPath path=AudioPaths[bank*AudioCapacity+base+g];
            uint support=AudioSpectral!=0?(uint)ceil(path.delaySeconds*AudioRate)+AudioLatency+AudioSize+AudioHrir+(AudioSinc!=0?AudioRadius:0):
                (uint)floor(path.delaySeconds*AudioRate)+AudioSize/2+AudioSize+AudioHrir+(AudioSinc!=0?2*AudioRadius-1:0);
            InterlockedMax(AudioMeta[9],support);
        }
    }
    AudioArgs[pair*3]=AudioCounts[bank*AudioPairs+pair];AudioArgs[pair*3+1]=1;AudioArgs[pair*3+2]=1;
    AudioArgs[(AudioPairs+pair)*3]=AudioMeta[2]==0?0:AudioCounts[AudioPairState[pair].y*AudioPairs+pair];
    AudioArgs[(AudioPairs+pair)*3+1]=1;AudioArgs[(AudioPairs+pair)*3+2]=1;
    InterlockedAdd(AudioMeta[13],AudioCounts[bank*AudioPairs+pair]);
}
// Match persistent paths by identity and frequency, not by compacted group position.
// The derivative bound is sufficient for a strictly increasing source clock.
bool AudioContinuous(AudioPath left,AudioPath right,float span)
{
    return span>0 && 2-left.direction.w-right.direction.w<=3*(1-(right.delaySeconds-left.delaySeconds)*AudioRate/span);
}
[numthreads(64,1,1)]
void AudioMatch(uint3 id:SV_GroupID,uint3 tid:SV_GroupThreadID)
{
    uint pair=id.x;uint4 banks=AudioPairState[pair];uint base=pair*AudioSlots;
    uint count=AudioCounts[banks.x*AudioPairs+pair],oldCount=AudioCounts[banks.y*AudioPairs+pair];
    if(tid.x==0)AudioSkip=AudioMeta[2]==0?1:0;GroupMemoryBarrierWithGroupSync();
    if(AudioSkip!=0){for(uint slot=tid.x;slot<count;slot+=64)AudioMatches[banks.x*AudioCapacity+base+slot]=-1;return;}
    for(uint bucket=tid.x;bucket<AudioHashSize;bucket+=64)
        if(AudioHashSize<=8191)AudioLocalTable[bucket]=0xffffffff;else AudioTable[pair*AudioHashSize+bucket]=int2(-1,-1);
    AllMemoryBarrierWithGroupSync();if(tid.x!=0)return;
    for(uint i=0;i<oldCount;i++)
    {
        uint g=base+i;AudioMatches[banks.y*AudioCapacity+g]=-1;
        AudioPath path=AudioPaths[banks.y*AudioCapacity+g];uint hash=AudioHash(path.identity^AudioHash(path.frequencyBin))%AudioHashSize;
        int2 entry=AudioLookup(pair,hash);
        while(entry.x>=0)
        {
            AudioPath existing=AudioPaths[banks.y*AudioCapacity+base+entry.x];
            if(existing.identity==path.identity && existing.frequencyBin==path.frequencyBin)break;
            hash=(hash+1)%AudioHashSize;entry=AudioLookup(pair,hash);
        }
        AudioInsert(pair,hash,entry.x<0?(int)i:entry.x,entry.x<0?(int)i:65535);
    }
    float span=AudioDifference(uint2(AudioMeta[19],AudioMeta[20]),uint2(AudioMeta[17],AudioMeta[18]));
    for(uint group=0;group<count;group++)
    {
        uint g=base+group;AudioMatches[banks.x*AudioCapacity+g]=-1;
        if(AudioSpectral==0 || AudioMeta[21]!=0 || AudioMeta[22]==0)continue;
        AudioPath path=AudioPaths[banks.x*AudioCapacity+g];uint hash=AudioHash(path.identity^AudioHash(path.frequencyBin))%AudioHashSize;
        for(uint probe=0;probe<AudioHashSize;probe++)
        {
            int2 entry=AudioLookup(pair,hash);int previous=entry.x;if(previous<0)break;
            AudioPath old=AudioPaths[banks.y*AudioCapacity+base+previous];
            if(old.identity==path.identity && old.frequencyBin==path.frequencyBin)
            {
                int used=AudioMatches[banks.y*AudioCapacity+base+previous];
                if(entry.y!=65535 && AudioContinuous(old,path,span))
                {
                    if(used>=0 && banks.x!=banks.y){AudioMatches[banks.x*AudioCapacity+used]=-1;AudioMatches[banks.y*AudioCapacity+base+previous]=-2;}
                    else if(used!=-2){AudioMatches[banks.x*AudioCapacity+g]=(int)base+previous;AudioMatches[banks.y*AudioCapacity+base+previous]=(int)g;}
                }
                break;
            }
            hash=(hash+1)%AudioHashSize;
        }
    }
}
void AudioFftShared(uint n,bool inverse,uint thread)
{
    uint bits=(uint)firstbithigh(n);
    for(uint i=thread;i<n;i+=256){uint j=reversebits(i)>>(32-bits);if(j>i){float2 v=AudioShared[i];AudioShared[i]=AudioShared[j];AudioShared[j]=v;}}
    GroupMemoryBarrierWithGroupSync();
    for(uint step=2;step<=n;step*=2)
    {
        for(uint i=thread;i<n/2;i+=256)
        {
            uint k=i%(step/2),at=(i/(step/2))*step+k;float angle=(inverse?2:-2)*AUDIO_PI*k/step;
            float2 a=AudioShared[at],b=AudioMultiply(AudioShared[at+step/2],float2(cos(angle),sin(angle)));
            AudioShared[at]=a+b;AudioShared[at+step/2]=a-b;
        }
        GroupMemoryBarrierWithGroupSync();
    }
    if(inverse){for(uint i=thread;i<n;i+=256)AudioShared[i]/=n;GroupMemoryBarrierWithGroupSync();}
}
[numthreads(256,1,1)]
void AudioFilter(uint3 group:SV_GroupID,uint3 tid:SV_GroupThreadID)
{
    if(tid.x==0)AudioSkip=AudioPairState[AudioPair].z==0?1:0;GroupMemoryBarrierWithGroupSync();
    if(AudioSkip!=0)return;uint g=AudioPair*AudioSlots+group.x,t=tid.x;
    for(uint n=t;n<AudioSize;n+=256)AudioShared[n]=0;GroupMemoryBarrierWithGroupSync();
    if(t==0)
    {
        int i=AudioHeads[g];
        for(uint visit=0;visit<AudioSlots && i>=0;visit++){AudioPath p=AudioArrivals[AudioOffset+i];AudioShared[p.frequencyBin]+=float2(p.pressureGain,p.pressureImag);i=AudioNext[i];}
        if(i>=0)AudioError(4);
        AudioShared[0].y=AudioShared[AudioSize/2].y=0;
    }
    GroupMemoryBarrierWithGroupSync();
    for(uint mirror=t+1;mirror<AudioSize/2;mirror+=256)AudioShared[AudioSize-mirror]=AudioShared[mirror]*float2(1,-1);GroupMemoryBarrierWithGroupSync();
    AudioFftShared(AudioSize,true,t);
    for(uint shift=t;shift<AudioSize/2;shift+=256){float2 a=AudioShared[shift];AudioShared[shift]=AudioShared[shift+AudioSize/2];AudioShared[shift+AudioSize/2]=a;}
    // Small transforms exchange bins across threads before clearing roundoff.
    GroupMemoryBarrierWithGroupSync();
    for(uint real=t;real<AudioSize;real+=256)AudioShared[real].y=0;
    for(uint pad=AudioSize+t;pad<AudioFft;pad+=256)AudioShared[pad]=0;GroupMemoryBarrierWithGroupSync();
    AudioFftShared(AudioFft,false,t);
    for(uint k=t;k<AudioBins;k+=256)AudioFilters[AudioFilterAt(AudioPairState[AudioPair].x,g)+k]=AudioShared[k];
