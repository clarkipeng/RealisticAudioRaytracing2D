// The Energy single-loop method (docs/benchmarks/methods-2026-11-06,
// docs/benchmarks/energy-audio-2026-11-09) in its own compute shader: it compiles only
// when that method is used, never with the renderer's Transport.compute or the other
// method. One solve: EnergyArrivals (exact discrete routes from the source), then
// EnergySelect (deterministic order; audio slots or histogram), EnergyExpand (audio
// paths) and TraceEnergy (the walk: the diffuse histogram).
#pragma kernel TraceEnergy3D
#pragma kernel TraceEnergy3DBvh USE_BVH
#pragma kernel EnergyArrivals3D
#pragma kernel EnergyArrivals3DBvh USE_BVH
#pragma kernel EnergySelectArrivals
#pragma kernel EnergyExpandArrivals
#pragma kernel EnergyEdgeWeights3D
#pragma kernel EnergyEdgeWeights3DBvh USE_BVH
#pragma kernel EnergyEdgeScanKernel
#pragma kernel ClearMethod
#pragma kernel EnergyAccumulateLate

#include "../../Shaders/Geometry.hlsl"
#include "../../Shaders/Transport.hlsl"
#include "../../Shaders/MethodCommon.hlsl"
#include "../../Shaders/MethodEnergy.hlsl"

[numthreads(64,1,1)] void TraceEnergy3D(uint3 id:SV_DispatchThreadID) { TraceEnergy(id.x); }
[numthreads(64,1,1)] void TraceEnergy3DBvh(uint3 id:SV_DispatchThreadID) { TraceEnergy(id.x); }
[numthreads(64,1,1)] void EnergyArrivals3D(uint3 id:SV_DispatchThreadID) { EnergyArrivals(MethodRayOffset + id.x); }
[numthreads(64,1,1)] void EnergyArrivals3DBvh(uint3 id:SV_DispatchThreadID) { EnergyArrivals(MethodRayOffset + id.x); }
[numthreads(64,1,1)] void EnergySelectArrivals(uint3 id:SV_DispatchThreadID) { EnergySelect(id.x); }
[numthreads(64,1,1)] void EnergyExpandArrivals(uint3 id:SV_DispatchThreadID) { EnergyExpand(id.x); }
[numthreads(64,1,1)] void EnergyEdgeWeights3D(uint3 id:SV_DispatchThreadID) { EnergyEdgeWeights(id.x); }
[numthreads(64,1,1)] void EnergyEdgeWeights3DBvh(uint3 id:SV_DispatchThreadID) { EnergyEdgeWeights(id.x); }
[numthreads(256,1,1)] void EnergyEdgeScanKernel(uint3 t:SV_GroupThreadID) { EnergyEdgeScan(t.x); }
[numthreads(64,1,1)] void EnergyAccumulateLate(uint3 id:SV_DispatchThreadID) { EnergyAccumulate(id.x); }
[numthreads(64,1,1)] void ClearMethod(uint3 id:SV_DispatchThreadID)
{
    ClearMethodBuffers(id.x);
    if (id.x + MethodClearOffset < MethodCountCells) MethodArrivalCounts[id.x + MethodClearOffset] = 0;
}
